# Required for Ask Risk AI and the TA builder's document reading / step drafting.
ANTHROPIC_API_KEY=
# Optional model override (default claude-sonnet-4-5).
# ANTHROPIC_MODEL=

# Long random string used to sign session cookies and TA document links.
SESSION_SECRET=

# Absolute path on a persistent volume in production (uploaded TA documents are stored alongside it).
# DATABASE_URL=/data/risk-register.db

# Public URL used in emails/webhook links (auto-detected from the request if unset).
# APP_URL=https://risk.sansom.co.nz

# TA workflow — can also be set in Settings → TA workflow (settings there take precedence).
# MAKE_WEBHOOK_URL=https://hook.eu2.make.com/...
# MFILES_EMAIL=
# HS_MANAGER_EMAIL=
# HS_MANAGER_NAME=
